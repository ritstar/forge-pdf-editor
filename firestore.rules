rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: users can only read/write their own profile
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Documents: users can only access their own documents
    match /documents/{docId} {
      allow read, write: if request.auth != null
        && (resource == null || resource.data.user_id == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;

      // Drafts subcollection
      match /drafts/{draftId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/documents/$(docId)).data.user_id == request.auth.uid;
      }
    }

    // Signatures: users can only access their own
    match /signatures/{sigId} {
      allow read, write: if request.auth != null
        && (resource == null || resource.data.user_id == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
    }

    // Tool history: users can only access their own
    match /tool_history/{historyId} {
      allow read, write: if request.auth != null
        && (resource == null || resource.data.user_id == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
    }
  }
}
